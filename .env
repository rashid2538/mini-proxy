# miniProxy Environment Configuration

# Whitelist / Blacklist patterns (regex patterns, comma-separated or JSON array)
# Leave WHITELIST_PATTERNS empty to allow all URLs (default)
WHITELIST_PATTERNS=
BLACKLIST_PATTERNS=

# Enable CORS headers (true/false)
FORCE_CORS=false

# Block access to local/private network addresses - SSRF protection (true/false)
DISALLOW_LOCAL=true

# Hide client IP address from target server - suppress X-Forwarded-For (true/false)
ANONYMIZE=true

# Request headers to strip before forwarding to the target (comma-separated, case-insensitive)
# Empty = forward all client headers (except built-in hop-by-hop headers)
BLOCK_HEADERS=

# Default URL to proxy when accessed without a target URL parameter
START_URL=

# Example URL shown on the landing page
LANDING_EXAMPLE_URL=https://example.net

# Security & Resource Limits
MAX_RESPONSE_SIZE=10485760
CONNECT_TIMEOUT=10
REQUEST_TIMEOUT=30
MAX_REDIRECTS=5
ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,HEAD,OPTIONS

# Logging (empty LOG_FILE = disabled)
LOG_FILE=
LOG_LEVEL=access
