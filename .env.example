# miniProxy Environment Configuration
#
# Copy this file to .env and adjust the values. Every key is optional —
# unset keys fall back to the defaults documented below.
# Real environment variables take priority over .env values.
#
# Lists (patterns, methods) are comma-separated.

# ── URL Access Control ──
# Comma-separated regular expressions (including delimiters, e.g.
# @^https?://([a-z0-9-]+\.)*example\.net@i).
# If a URL matches both lists, it is treated as blacklisted.
#
# WHITELIST_PATTERNS: empty = allow proxying any URL.
# BLACKLIST_PATTERNS: empty = block nothing.
WHITELIST_PATTERNS=
BLACKLIST_PATTERNS=

# ── Behavior ──
# FORCE_CORS: enable cross-origin resource sharing for proxied sites (true/false).
FORCE_CORS=false

# DISALLOW_LOCAL: block local/private network targets (SSRF protection). Recommended: true.
DISALLOW_LOCAL=true

# ANONYMIZE: hide the client's IP from proxied sites (suppress X-Forwarded-For).
ANONYMIZE=true

# BLOCK_HEADERS: comma-separated request headers stripped before forwarding to
# the destination (case-insensitive), in addition to built-in hop-by-hop headers.
# Empty = forward all client headers (minus built-ins). Example: Authorization,Cookie
BLOCK_HEADERS=

# START_URL: URL proxied by default when miniProxy is accessed with no target.
# Empty = show the built-in landing page instead.
START_URL=

# LANDING_EXAMPLE_URL: example URL shown/proxied from the landing page.
LANDING_EXAMPLE_URL=https://example.net

# ── Security Limits ──
# MAX_RESPONSE_SIZE: maximum upstream response size in bytes.
MAX_RESPONSE_SIZE=10485760

# CONNECT_TIMEOUT: cURL connection timeout in seconds.
CONNECT_TIMEOUT=10

# REQUEST_TIMEOUT: cURL total request timeout in seconds.
REQUEST_TIMEOUT=30

# MAX_REDIRECTS: maximum number of upstream redirects to follow.
# Every hop is re-validated (whitelist/blacklist + SSRF checks).
MAX_REDIRECTS=5

# DNS_CACHE_TTL: seconds to cache validated DNS results per request (0 disables).
# A redirect chain revisiting the same host resolves it only once per request.
DNS_CACHE_TTL=300

# ALLOWED_METHODS: HTTP methods the proxy may send upstream.
ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,HEAD,OPTIONS

# ── Logging ──
# LOG_FILE: path to a log file (e.g. /var/log/miniproxy.log). Each request is
# appended with timestamp, client IP, method, target URL, status, bytes and
# duration. Empty = logging disabled.
# LOG_LEVEL: minimum verbosity — error, access (default), info or debug.
#   error   = errors only
#   access  = errors + one line per request (default)
#   info    = + redirect hops, response lines
#   debug   = + DNS validation, upstream request/response, header names
# Header VALUES are never logged; only header names.
LOG_FILE=
LOG_LEVEL=access
